rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /public/{allPaths=**} {
      allow read; // expect-warn: data/firebase-open-rules
    }
    match /uploads/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId; // ok: owner check
    }
    match /{allPaths=**} {
      allow write: if true; // expect-block: data/firebase-open-rules
    }
  }
}
