rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true; // expect-block: data/firebase-open-rules
      allow write: if request.auth != null; // expect-warn: data/firebase-open-rules
    }
    match /{path=**}/comments/{commentId} {
      allow read: if resource.data.visible == true; // ok: reads limited to visible comments
      allow update: if request.auth.uid != null && request.auth.uid == resource.data.author; // ok: author check
    }
    match /drafts/{draftId} {
      allow update: if request.auth.uid != null; // ok: signed-in writes on one path are not reported
    }
  }
}
