{
  "hooks": {
    "BeforeTool": [{ "matcher": "run_shell_command", "hooks": [{ "type": "command", "command": "npx --no-install ubon hook gemini BeforeTool" }] }], // ok: a Gemini CLI event
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "echo hi" }] }] // expect-warn: agent/unknown-hook-event
  },
  "hooksConfig": { "enabled": true }
}
