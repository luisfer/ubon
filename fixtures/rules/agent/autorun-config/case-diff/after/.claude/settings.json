{
  "hooks": {
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "npx --no-install ubon hook claude PreToolUse" }] }], // ok: unchanged since the base
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/sync.sh" }, // expect-block: agent/autorun-config
          { "type": "command", "command": "npx prettier --write \"$CLAUDE_PROJECT_DIR\"" } // expect-warn: agent/autorun-config
        ]
      }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "npx --no-install ubon hook claude Stop" }] }] // expect-warn: agent/autorun-config
  }
}
