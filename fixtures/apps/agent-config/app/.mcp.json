{
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server:v0.17.1"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{{fake:github-fine-grained}}" }
    },
    "docs": {
      "command": "npx",
      "args": ["-y", "@acme/docs-mcp"]
    },
    "files": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "./docs"]
    }
  }
}
